{{#> base title="Exam Registration Confirmation"}}
<h2>Hello {{username}},</h2>

<p>Your registration for the exam <strong>{{examTitle}}</strong> has been confirmed.</p>

<div class="info-box">
    <h3>Exam Details</h3>
    <table>
        <tr>
            <th>Date & Time:</th>
            <td>{{examDate}}</td>
        </tr>
        <tr>
            <th>Duration:</th>
            <td>{{duration}} minutes</td>
        </tr>
    </table>
</div>

<div class="warning-box">
    <h3>Important Instructions</h3>
    <ul>
        {{#each instructions}}
        <li>{{this}}</li>
        {{/each}}
    </ul>
</div>

<p>Please make sure to:</p>
<ul>
    <li>Log in at least 10 minutes before the exam starts</li>
    <li>Have a stable internet connection</li>
    <li>Keep your webcam and microphone ready if required</li>
    <li>Read all instructions carefully before starting the exam</li>
</ul>

<p>We will send you a reminder email 24 hours before the exam.</p>

<a href="{{loginLink}}" class="button">View Exam Details</a>

<p>Good luck with your exam!</p>
{{/base}}
